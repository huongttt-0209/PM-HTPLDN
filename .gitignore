# Chrome browser profiles & QA automation temp files
.tmp-qa/

# Thư mục tạm khi chạy QA (dọn 2026-08-12 — xem lý do bên dưới)
# .tmp/        = snapshot DOM, export nháp, output Playwright MCP
# .tmp-*/      = fixture upload, frame video, note reverify 1 lần
.tmp/
.tmp-*/

# DOM dump ở gốc repo (tmp-vuviec-list.json, tmp-admin-menu.json...)
# Neo bằng "/" để không ảnh hưởng file cùng tên trong thư mục con
/tmp-*.json

# File nháp trung gian khi soạn report (seed-checklist-X.md.tmp)
*.md.tmp

# Bản backup thủ công trước khi sửa file
*.bak
*.bak-*

# Session id / lock của agent — máy nào riêng máy đó
.context/
.claude/scheduled_tasks.lock

# Output test runner
test-results/

# macOS system files
.DS_Store
**/.DS_Store

# gstack internal logs
.gstack/browse-console.log
.gstack/browse-network.log
.gstack/browse-audit.jsonl
.gstack/qa-reports/

# Claude hooks
.claude/hooks/

# Node modules (if any)
node_modules/
.gstack/

